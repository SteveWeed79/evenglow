# TLS, and the third of `DESIGN-BRIEF.md` gap 7's four missing pieces.
#
#   sudo cp scripts/deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo sed -i "s/api.example.com/api.swbuild.dev/" /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy obtains and renews the certificate by itself — there is no certbot, no
# cron job and no renewal that expires quietly eighteen months from now. That
# is the whole reason it is here rather than nginx.
#
# ## Why the app cannot simply talk to :3001
#
# Android blocks cleartext HTTP by default for anything targeting SDK 28 or
# later, and `app.json` sets no `usesCleartextTraffic` — so `http://<ip>:3001`
# fails from the handset with no useful message. Which is correct: access
# tokens, refresh tokens and passwords are on that wire.
#
# A certificate needs a NAME. Let's Encrypt will not issue for a bare IP, which
# is why a subdomain is the cheap part of this and the box's address is not
# enough on its own.
#
# ## The DNS half, which has to be done first
#
# One A record, at whoever hosts the zone:
#
#   api    A    <the box's public IP>
#
# It does not touch the apex or `www`, so a portfolio on the same domain is
# unaffected — different record, different host, different certificate.
#
# **If the zone is on Cloudflare, leave this record grey (DNS only).** An
# orange-clouded record proxies through Cloudflare, which terminates TLS
# itself — so Caddy's challenge cannot complete, and if it did, the hop count
# below would be wrong.

api.example.com {
	# ── The app itself, for a phone to install ──────────────────────────────
	#
	# `docs/TESTING-BUILD.md` §7. EAS builds the APK; this serves it, and the
	# split is deliberate — the signing key stays in Expo's credential store
	# rather than on an internet-facing box, which §8 argues is the one piece of
	# state that must not live here.
	#
	# **Caddy serves this, Fastify never sees it.** A static file needs no route,
	# no auth and no database, so the API's surface does not grow by one byte to
	# get a download. `handle_path` strips the prefix and is matched before the
	# proxy below, so nothing under /app reaches the service.
	#
	# ## Why not just send the EAS link
	#
	# EAS mints a NEW url for every build and its artefacts expire after thirty
	# days on the free tier. That makes "here is the app" a message you send
	# again every time, and a link that dies in a month for anybody who kept it.
	# This url never changes: replace the file, the link still works.
	#
	# A GitHub release does not expire but has no install page, and on a public
	# repository it puts the APK in front of everybody — the same consideration
	# that keeps SUPPORT_ACCEPT_RECORDS off.
	#
	# ## Outside the repository, on purpose
	#
	# `/var/lib/steading/dist` rather than anywhere under /opt/steading. The
	# deploy timer pulls into that tree every five minutes, so an APK kept there
	# would be one `git clean` from gone — and a directory Caddy serves should
	# not be a directory a deploy writes to.
	#
	#   sudo install -d -m 0755 /var/lib/steading/dist
	#
	# Put a build there with `scripts/deploy/publish-apk.sh`, which is where the
	# naming and the symlink are explained.
	handle_path /app/* {
		root * /var/lib/steading/dist

		# Android installs from a plain octet-stream perfectly well, but the
		# correct type is what stops a browser deciding an APK is something to
		# display. Set here rather than hoped for.
		header /*.apk Content-Type application/vnd.android.package-archive

		# The install page is small and the APK is not. Caching the page would
		# hide the version note somebody was sent to read.
		header /index.html Cache-Control "no-cache"

		# `browse` is deliberately absent: this directory holds exactly what is
		# meant to be downloaded, and a listing is a habit that stops being safe
		# the first time something else is put there.
		file_server
	}

	# So the address a person is given can be said out loud without a slash.
	redir /app /app/ permanent

	# The API binds 127.0.0.1 through this proxy rather than being exposed
	# directly, so the only thing on a public port is Caddy.
	reverse_proxy 127.0.0.1:3001 {
		# Photos stream through this service. The default 60s is plenty for a
		# 400KB image on a barn's signal, but a phone that spent 30s uploading
		# and got cut off has a rejected mutation and no idea why.
		transport http {
			response_header_timeout 120s
		}
	}

	# Caddy sets X-Forwarded-For itself. The service must be told to believe
	# exactly one hop — `TRUSTED_PROXY_HOPS=1` in /etc/steading/api.env — or
	# `request.ip` is 127.0.0.1 for every request and every rate limiter in the
	# service counts the whole internet as one caller. See env.ts.

	encode zstd gzip

	log {
		output file /var/log/caddy/steading.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

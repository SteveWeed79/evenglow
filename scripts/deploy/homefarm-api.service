# The farm API, as a service that comes back.
#
#   sudo cp scripts/deploy/homefarm-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now homefarm-api
#
# `DESIGN-BRIEF.md` gap 7 listed "no process supervisor" beside the missing
# container image. This is the supervisor: systemd restarts the service when it
# dies and starts it when the box reboots, which is the whole job. Oracle
# reboots instances for maintenance, and a farm should not discover that.

[Unit]
Description=Evenglow farm API
Documentation=https://github.com/SteveWeed79/steading/blob/main/docs/OPERATOR.md
# `network-online`, not `network`. The latter fires when the interface exists,
# which on a cloud instance is before it has an address — and the service would
# come up, fail to resolve Atlas, and be restarted five seconds later for no
# reason anybody could see in the logs.
After=network-online.target
Wants=network-online.target

# A service that cannot start must not spin: five restarts inside a minute
# stops it and leaves the reason in `systemctl status` instead of burying it in
# a scrolling log. A bad MONGODB_URI is exactly this shape.
#
# **These belong in [Unit], and the first draft had them in [Service].**
# systemd moved them in 229 and now ignores them there with a warning nobody
# reads — so the guard was decorative and the restart storm it exists to stop
# would have happened anyway. Found by `systemd-analyze verify`, which is worth
# running against this file after any edit:
#
#   systemd-analyze verify scripts/deploy/homefarm-api.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=homefarm
Group=homefarm

# The checkout, not the deploy tree. `pnpm install` at the repo root with
# `node-linker=hoisted` (see .npmrc) puts tsx in the root node_modules, and the
# service runs the TypeScript source directly — see the Dockerfile for why
# there is no compile step and why that is not laziness.
WorkingDirectory=/opt/homefarm/apps/api
ExecStart=/usr/bin/node /opt/homefarm/node_modules/tsx/dist/cli.mjs src/server.ts

# AUTH_SECRET and MONGODB_URI live here, mode 0600, and nowhere else. Not in
# the unit file, which is world-readable in /etc/systemd/system.
EnvironmentFile=/etc/homefarm/api.env

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=homefarm-api

# ── hardening ───────────────────────────────────────────────────────────────
#
# This process is reachable from the internet and holds a database credential.
# None of the below costs anything at this scale, and each one removes a way a
# remote-code bug turns into a compromised box.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
#
# **AF_NETLINK is required and its absence killed the first real deployment.**
#
# The obvious list is AF_INET, AF_INET6 and AF_UNIX — a service that speaks TCP
# and nothing else. It is wrong, and wrong in a way no test could catch, because
# the failure happens *after* the port is successfully bound:
#
#   SystemError [ERR_SYSTEM_ERROR]: uv_interface_addresses returned
#   Unknown system error 97      <- EAFNOSUPPORT
#       at Object.networkInterfaces (node:os)
#       at getAddresses (fastify/lib/server.js)
#       at Server.listeningEventHandler (fastify/lib/server.js)
#
# `listen()` on a wildcard address makes Fastify enumerate the machine's
# interfaces so it can report every address it is now reachable on. On glibc
# that is `getifaddrs()`, which opens a NETLINK_ROUTE socket — so denying
# AF_NETLINK denies interface enumeration, and Node throws from the listening
# handler rather than from anything that looks like configuration.
#
# The symptom is the worst shape available: the service binds, then exits 1,
# restarts five times in a minute and stops, and the journal blames a syscall
# in libuv. Nothing points at this line.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# `ProtectSystem=strict` makes the whole filesystem read-only, and nothing here
# needs to write: SQLite is on the handset, photos are in Mongo, and the logs
# go to the journal. If that ever stops being true — a local upload directory,
# a cache — this is the line that has to name it, deliberately.
#
# MemoryDenyWriteExecute stays FALSE on purpose. V8 is a JIT: it maps memory
# writable and then executable, so setting it true kills Node at startup with a
# SIGSEGV that looks like a crash in the app rather than a policy denial.

[Install]
WantedBy=multi-user.target

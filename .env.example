# Copy to .env.local and fill in. Never commit .env.local.
#
# Nothing here may be prefixed NEXT_PUBLIC_ (invariant 7). `pnpm check:secrets`
# fails the build if a value from this file reaches the client bundle.

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017

# Database name. Defaults to "steading" when unset.
MONGODB_DB=steading

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set when self-hosting behind a proxy so Auth.js trusts the forwarded host.
# Not needed on Vercel.
# AUTH_TRUST_HOST=true

# ── Fastify API (pnpm dev:api) ──────────────────────────────────────────────
# PORT=3001
#
# Comma-separated, and deliberately not defaulted to "*" — a wildcard with
# credentials is the mistake this field exists to prevent. Add the WebView's
# origin when testing on a device: Capacitor serves the APK from
# https://localhost, which is a different origin from the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,https://localhost

# ── Tests ───────────────────────────────────────────────────────────────────
# Point the database-backed suites at a real mongod. Without this they fall
# back to mongodb-memory-server, which downloads a binary on first run.
# MONGODB_TEST_URI=mongodb://localhost:27017
#
# Set to 1 to make an unavailable test database a hard failure instead of a
# skip. CI sets this.
# STEADING_REQUIRE_DB=1

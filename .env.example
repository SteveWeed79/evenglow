# Copy to .env.local and fill in. Never commit .env.local.
#
# ── THIS FILE IS THE SERVER. THE APP HAS ITS OWN. ───────────────────────────
#
# These are read by the Fastify API (`pnpm dev:api`, `pnpm farm`) from the
# repository root. The app in apps/mobile reads a DIFFERENT file —
# `apps/mobile/.env` — and that is where EXPO_PUBLIC_API_URL lives. A perfect
# copy of this file with no apps/mobile/.env is a server nothing talks to.
#
# Nothing here may be prefixed EXPO_PUBLIC_ (invariant 12): Expo inlines those
# into the JavaScript bundle, which ships inside an APK and is trivially
# unpacked. `pnpm check:secrets` fails the build if a value from this file
# reaches the bundle.

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017

# Database name. Defaults to "steading" when unset.
#
# Whatever you put here is the database `pnpm db:indexes`, `pnpm db:seed` and
# the server all use. Change it after seeding and you get an empty farm with no
# error, because an empty database is indistinguishable from a new one.
MONGODB_DB=steading

# The signing key for this server's own access and refresh tokens.
# Generate with: openssl rand -base64 32
#
# At least 32 characters — HS256 keys shorter than the digest are weaker than
# the algorithm implies. Changing it invalidates every token in the field, so
# every device signs in again; nothing on any device is lost, because the
# records are local (D9).
AUTH_SECRET=

# ── Behind a proxy ──────────────────────────────────────────────────────────
# How many proxies you control sit in front of this service. Unset means none.
#
# Every rate limiter in the service keys on the client IP, and the auth limiter
# is what stands between a password and unlimited guesses. Trusting
# X-Forwarded-For unconditionally makes that IP a value the caller chooses, so
# the default is to trust nothing.
#
# Set it to the number of hops you actually run — 1 behind a single nginx or a
# load balancer — and the address that many from the right is used, which a
# caller cannot forge past. Direct-to-internet: leave it unset.
# TRUSTED_PROXY_HOPS=1

# ── Google sign-in (A2.4) ───────────────────────────────────────────────────
# Comma-separated OAuth client ids — the Android one, and the web one Expo's
# auth proxy uses in development. Make them in Google Cloud Console under
# APIs & Services → Credentials.
#
# These are PUBLIC by design and belong here rather than in a vault: a client
# id ships in every OAuth app there has ever been, and the device flow is PKCE
# so no client SECRET is used at all. What matters is that the list is exact —
# it is the audience check that stops a Google token minted for somebody
# else's application being accepted as one of ours.
#
# Leave it unset and Google sign-in answers 501 with a sentence naming this
# variable, the button is not drawn in the app, and email and password keep
# working. That is a supported state, not a broken one.
# GOOGLE_CLIENT_IDS=123-android.apps.googleusercontent.com,456-web.apps.googleusercontent.com

# ── Fastify API (pnpm dev:api) ──────────────────────────────────────────────
# PORT=3001
#
# Comma-separated, and deliberately not defaulted to "*" — a wildcard with
# credentials is the mistake this field exists to prevent.
#
# **The app does not need this.** React Native is not a browser and sends no
# Origin header, so CORS never applies to a handset — the default below is a
# leftover from the deleted Vite client. It only matters if something in a
# browser ever calls this API.
# CORS_ORIGINS=http://localhost:5173

# ── Tests ───────────────────────────────────────────────────────────────────
# Point the database-backed suites at a real mongod. Without this they fall
# back to mongodb-memory-server, which downloads a binary on first run.
# MONGODB_TEST_URI=mongodb://localhost:27017
#
# Set to 1 to make an unavailable test database a hard failure instead of a
# skip. CI sets this.
# STEADING_REQUIRE_DB=1

# ── Google Play billing (D13) ───────────────────────────────────────────────
# The service-account JSON from Google Cloud, verbatim and on one line. Grant
# it the "View financial data" permission in Play Console → Users and
# permissions, and enable the Google Play Android Developer API.
#
# THIS IS A PRIVATE KEY. Unlike GOOGLE_CLIENT_IDS above, it is a real secret:
# server-side only, never in a bundle, never in a log line.
#
# Leave it unset and the billing routes answer 501, every farm stays on the
# free tier, and nothing else changes. That is a supported state, not a broken
# one — it is what the app does today.
# GOOGLE_PLAY_SERVICE_ACCOUNT={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
#
# The package a purchase must belong to, so a token minted for some other app
# cannot be presented here.
# GOOGLE_PLAY_PACKAGE=com.steading.app

# Farms that sync free, whatever the store says. Comma-separated farm ids.
#
# For testers, and for your own account. A farm reads its own id from
# Settings -> Sync, at the bottom; it is not a secret, and it is the only
# handle that identifies a farm to whoever runs the server.
#
# Configuration rather than a route, deliberately: a grant that can be
# requested is a grant that can be requested by anybody. Nothing a client
# sends can reach this.
#
# It grants sync and nothing else, because there is nothing else to grant —
# the free tier is already the whole app on one device.
# FREE_SYNC_ORGS=01J0000000000000000000ORG1,01J0000000000000000000ORG2

# ── Support tickets (docs/SUPPORT-LOOP.md) ──────────────────────────────────
# A GitHub token with issue write on the repository below. Absent, /support
# answers 501 and the app offers its share sheet instead — which is a supported
# state and the only one a self-hosted farm will ever be in.
# SUPPORT_GITHUB_TOKEN=
# SUPPORT_REPO=SteveWeed79/steading
#
# Whether a farm's own records may be accepted alongside a report (S5).
#
# LEAVE THIS OFF UNTIL THE REPOSITORY IS PRIVATE. An issue on a public repo is
# world-readable, and a farm cannot meaningfully consent to that on a prompt in
# a barn. The gate is here rather than in the app because the app cannot know a
# repository's visibility, and a build shipped today would be wrong about it
# forever. Anything that is not an explicit 1 or true is a no.
# SUPPORT_ACCEPT_RECORDS=

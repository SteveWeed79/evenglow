{
  "name": "homefarm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench:store": "tsx scripts/bench-store.mts",
    "check:assets": "node scripts/check-assets.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:no-db-disables": "node scripts/check-no-db-disables.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "db:indexes": "pnpm --filter @homefarm/api db:indexes",
    "db:password": "pnpm --filter @homefarm/api db:password",
    "db:seed": "pnpm --filter @homefarm/api db:seed",
    "db:usage": "pnpm --filter @homefarm/api db:usage",
    "db:verify": "pnpm --filter @homefarm/api db:verify",
    "dev:api": "pnpm --filter @homefarm/api dev",
    "e2e": "playwright test",
    "farm": "node scripts/dev-server.mjs",
    "farm:grant": "pnpm --filter @homefarm/api farm:grant",
    "farm:ls": "pnpm --filter @homefarm/api farm:ls",
    "farm:show": "pnpm --filter @homefarm/api farm:show",
    "gen:plaster": "node scripts/make-plaster.mjs",
    "lint": "eslint",
    "make:icon": "node scripts/make-icon.mjs",
    "mobile": "pnpm --filter @homefarm/mobile start",
    "mobile:android": "pnpm --filter @homefarm/mobile android",
    "mobile:export": "pnpm --filter @homefarm/mobile export",
    "mobile:prebuild": "pnpm --filter @homefarm/mobile prebuild",
    "mobile:usb": "pnpm --filter @homefarm/mobile start:usb",
    "ops": "pnpm --filter @homefarm/api ops",
    "ops:admin": "pnpm --filter @homefarm/api ops:admin",
    "promo:new": "pnpm --filter @homefarm/api promo:new",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm typecheck:mobile",
    "typecheck:mobile": "pnpm --filter @homefarm/mobile typecheck",
    "verify:alerts": "tsx scripts/verify-alerts.mts"
  },
  "dependencies": {
    "@homefarm/api": "workspace:*",
    "@homefarm/contracts": "workspace:*",
    "@homefarm/core": "workspace:*",
    "mongodb": "^7.5.0",
    "react": "19.2.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@homefarm/core": "workspace:*",
    "@homefarm/mobile": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-test-renderer": "19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "mongodb-memory-server": "^11.2.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "expo-constants": "~57.0.10"
    }
  }
}

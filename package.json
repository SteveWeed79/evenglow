{
  "name": "steading",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && pnpm typecheck:mobile",
    "typecheck:mobile": "pnpm --filter @steading/mobile typecheck",
    "mobile": "pnpm --filter @steading/mobile start",
    "mobile:android": "pnpm --filter @steading/mobile android",
    "mobile:prebuild": "pnpm --filter @steading/mobile prebuild",
    "mobile:export": "pnpm --filter @steading/mobile export",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:indexes": "pnpm --filter @steading/api db:indexes",
    "db:seed": "pnpm --filter @steading/api db:seed",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "check:no-db-disables": "node scripts/check-no-db-disables.mjs",
    "check:chunks": "node scripts/check-native-chunks.mjs",
    "db:verify": "pnpm --filter @steading/api db:verify",
    "build:app": "pnpm --filter @steading/app build",
    "dev:app": "pnpm --filter @steading/app dev",
    "dev:api": "pnpm --filter @steading/api dev",
    "cap:sync": "pnpm build:app && pnpm --filter @steading/app cap:sync",
    "cap:run:android": "pnpm cap:sync && pnpm --filter @steading/app cap:run:android",
    "cap:open:android": "pnpm --filter @steading/app cap:open:android"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@steading/api": "workspace:*",
    "@steading/app": "workspace:*",
    "@steading/contracts": "workspace:*",
    "idb": "^8.0.3",
    "mongodb": "^7.5.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@steading/mobile": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

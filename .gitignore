# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: pnpm links dependencies into every workspace package, so
# /node_modules alone would leave packages/*/node_modules tracked.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# Vite build output. The bundle is produced by `pnpm build:app`; committing it
# means every UI change carries a 300 kB diff, and a stale copy would satisfy
# the secret scan while the current source leaked.
apps/*/dist/

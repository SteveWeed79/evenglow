# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*

# testing
/coverage

# build output
/build
apps/app/dist/

# Capacitor native build output. The android/ project itself IS committed —
# it carries signing config, permissions, and plugin registration that a
# `cap add` would silently regenerate differently.
apps/app/android/app/build/
apps/app/android/build/
apps/app/android/.gradle/
apps/app/android/local.properties
apps/app/android/app/src/main/assets/public/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and must be committed.
!.env.example

# typescript
*.tsbuildinfo

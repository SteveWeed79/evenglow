# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: pnpm links dependencies into every workspace package, so
# /node_modules alone would leave packages/*/node_modules tracked.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# Vite build output. The bundle is produced by `pnpm build:app`; committing it
# means every UI change carries a 300 kB diff, and a stale copy would satisfy
# the secret scan while the current source leaked.
apps/*/dist/

# expo / react native
apps/mobile/.expo/
apps/mobile/.expo-export/
# And the one at the root, which the Expo CLI writes when it is run from there
# rather than from apps/mobile. Only the nested path was listed, so a farm's
# "Check my setup" printed `CHANGED: ?? .expo/` as though somebody had edited
# the project — noise in the one window that exists to make real changes stand
# out.
/.expo/
# Generated by `expo prebuild` from app.json. Regenerate rather than commit —
# unlike the Capacitor project, nothing is hand-edited in here.
apps/mobile/android/
apps/mobile/ios/

# Local development database made by `pnpm farm`
.steading-data/

# JetBrains IDEs
.idea/

# Signing keys, and this one is not tidiness.
#
# EAS generates a keystore on the first build and holds it; `eas credentials`
# downloads a copy to back up, and the natural place somebody puts that copy is
# wherever the terminal happened to be — which is this directory.
#
# **It cannot be rotated.** Every APK is signed with it and Android only accepts
# an update signed by the same key, so losing it means every installed copy needs
# an uninstall to take a new build — which takes the farm's records with it. And
# committing it to a public repository is worse than losing it, because then
# anybody can sign an app that Android will install straight over this one.
#
# `credentials.json` is eas-cli's own local-credentials file and holds the
# keystore passwords in plain text.
*.jks
*.keystore
*.p12
*.p8
credentials.json

# Build output from the retired Capacitor client. The directory is not in the
# repository — it was deleted when the web client was retired — but a checkout
# that predates that still has Gradle writing into it, and those writes block
# every later `git pull` with "your local changes would be overwritten".
apps/app/

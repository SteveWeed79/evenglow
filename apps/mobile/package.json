{
  "name": "@steading/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:usb": "expo start --dev-client --host localhost",
    "android": "pnpm stamp && expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "export": "pnpm stamp && expo export --platform android --output-dir .expo-export",
    "stamp": "node ../../scripts/stamp-build.mjs",
    "eas-build-post-install": "node ../../scripts/stamp-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.4.0",
    "@steading/contracts": "workspace:*",
    "@steading/core": "workspace:*",
    "expo": "~57.0.12",
    "expo-auth-session": "^57.0.6",
    "expo-crypto": "^57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-location": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-splash-screen": "^57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "paths": {
      "@steading/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "*.js"],
  "exclude": ["node_modules", ".expo", ".expo-export", "android", "ios"]
}

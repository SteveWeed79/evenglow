{
  "name": "@steading/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:indexes": "tsx --env-file-if-exists=../../.env.local src/db/apply-indexes.mts",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/db/seed.mts",
    "db:usage": "tsx --env-file-if-exists=../../.env.local src/db/usage.mts",
    "db:verify": "tsx --env-file-if-exists=../../.env.local src/db/verify.mts",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env.local src/server.ts",
    "db:password": "tsx --env-file-if-exists=../../.env.local src/db/set-password.mts",
    "promo:new": "tsx --env-file-if-exists=../../.env.local src/db/new-promo.mts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@steading/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "mongodb": "^7.5.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}

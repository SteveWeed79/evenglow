# Copy to .env.local in this directory. Vite reads it from the app root, not
# the repo root, and inlines VITE_* values into the bundle at build time.
#
# Nothing secret belongs here. This file's values ship inside the APK, which
# is trivially unpacked (invariant 12).

# Absolute origin of the Fastify API. REQUIRED for the native build and
# ignored by the browser build, which talks to its own origin.
#
# The APK serves the app from its own origin, so a relative /sync resolves to
# the bundle rather than to a server. Without this the app fails at bootstrap
# — deliberately, because the alternative is a device that queues all morning
# and only reveals the problem when someone checks the sync chip.
#
#   Android emulator  → the host machine is 10.0.2.2, never localhost
#   Physical handset  → your machine's LAN address, e.g. 192.168.1.20
#
# The API listens on 3001 by default.
VITE_API_BASE_URL=http://10.0.2.2:3001
